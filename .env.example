# Copy to .env.local for development. Never commit real values.
# In production, set every secret in Vercel Project Settings.

# LINE Messaging API / Login
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
NEXT_PUBLIC_LIFF_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose to the client or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# OCR / categorizer LLM
ANTHROPIC_API_KEY=

# App security
SESSION_JWT_SECRET=
CRON_SECRET=

# Public base URL, e.g. https://meetang.vercel.app
APP_BASE_URL=
